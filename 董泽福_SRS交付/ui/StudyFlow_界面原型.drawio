        </mxCell>
        <mxCell id="n31" value="题目：校园学习行为调研与改进方案" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="308" width="202.0" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n32" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="330" width="2.0" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n33" value="要求：" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="58" y="352" width="39.5" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n34" value="1. 每组 3–4 人，提交一份 " style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="374" width="148.5" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n35" value="PDF 报告" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#2f6fe4;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="204.5" y="374" width="55.5" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n36" value="，正文不少于 " style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="258.0" y="374" width="80.5" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n37" value="3000 字" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#2f6fe4;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="336.5" y="374" width="48.0" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n38" value="；" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="382.5" y="374" width="14.5" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="报告需包含调研方法、数据分析、问题诊断与改进建议。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="396" width="314.5" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n40" value="2. 报告提交截止：" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="418" width="103.5" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n41" value="第 8 周周日 23:59" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#a86500;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="159.5" y="418" width="103.5" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n42" value="（通知未给出具体日期）。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="261.0" y="418" width="152.0" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n43" value="3. 每组成员需在课堂展示 " style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="440" width="144.5" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n44" value="8–10 分钟" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#2f6fe4;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200.5" y="440" width="60.0" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n45" value="，并提交 " style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="258.5" y="440" width="55.5" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n46" value="10 页以内的幻灯片。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#2f6fe4;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="58" y="462" width="120.5" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n47" value="4. 提交材料包括：报告 PDF、展示幻灯片、小组分工说明" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="484" width="318.0" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="（含每人贡献比例）。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="506" width="127.0" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n49" value="5. 引用格式采用 GB/T 7714；查重率不得高于 20%。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="528" width="300.0" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="6. 迟交每天扣 10%，超过 3 天不予受理。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="550" width="235.0" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n51" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="572" width="2.0" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="7. 评分构成：报告 60%，课堂展示 30%，" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="594" width="237.5" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n53" value="小组协作与分工 10%。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="616" width="131.5" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n54" value="8. 请在课程平台“作业 3”处提交；逾期按第 6 条处理。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="638" width="316.5" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n55" value="9. 课堂展示顺序由抽签决定，展示当天请全员到场。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="660" width="291.0" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="n56" value="10. 如需延期，须在第 8 周前向任课教师书面申请。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=12.5;fontColor=#22303f;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="682" width="288.0" height="19.4" as="geometry" />
        </mxCell>
        <mxCell id="e57" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#d7dfe9;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="44" y="838" as="sourcePoint" />
            <mxPoint x="474" y="838" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n58" value="" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#efeafc;strokeColor=none;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#22303f;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="44" y="850" width="58.0" height="22.5" as="geometry" />
        </mxCell>
        <mxCell id="n59" value="业务数据" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=10.5;fontColor=#6a4bb5;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="44" y="850" width="58.0" height="22.5" as="geometry" />
        </mxCell>
        <mxCell id="n60" value="原文中的命令性文字只作业务内容，不会扩大系统或 AI 的权限；保存与修改均记录操作者与版本。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=10.5;fontColor=#5d6f82;fontStyle=0;" vertex="1" parent="1">
